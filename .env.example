# ─── App ───────────────────────────────────────────────
APP_URL=http://localhost:6401
# Signs the local demo-login cookie (only used when Supabase is not configured).
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Supabase (Auth + Postgres) ────────────────────────
# Project settings → API. When unset, the app falls back to a seeded
# in-memory store + a demo login so it still runs locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable LinkedIn in: Supabase Dashboard → Authentication → Providers → LinkedIn (OIDC).
# Add http://localhost:6401/auth/callback to the provider's redirect URLs.

# ─── AI provider (optional) ────────────────────────────
# If neither key is set, the composer uses a deterministic local fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Scheduler / WhatsApp (Twilio) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Secret the Vercel Cron dispatcher (/api/cron/dispatch) must present.
# Generate a long random string; set the same value in the Vercel project env.
CRON_SECRET=

# ─── Billing (Stripe) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
